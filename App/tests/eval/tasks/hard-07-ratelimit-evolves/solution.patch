+class Clock:
+    def __init__(self, t=0.0):
+        self.t = t
+
+    def __call__(self):
+        return self.t
+
+
+class Tests(unittest.TestCase):
+    def test_bucket_drains_and_refills(self):
+        c = Clock()
+        b = TokenBucket(2, 1, c)
+        self.assertTrue(b.allow())
+        self.assertTrue(b.allow())
+        self.assertFalse(b.allow())
+        c.t = 1
+        self.assertTrue(b.allow())
+
+    def test_cost_over_capacity(self):
+        b = TokenBucket(2, 1, Clock())
+        self.assertFalse(b.allow(3))
+        self.assertEqual(b.tokens, 2)
+
+    def test_limiter_per_key(self):
+        L = Limiter(1, 1, Clock())
+        self.assertTrue(L.allow("a"))
+        self.assertTrue(L.allow("b"))
+        self.assertFalse(L.allow("a"))
+
+    def test_clock_backwards(self):
+        c = Clock(10)
+        b = TokenBucket(3, 1, c)
+        b.allow(3)
+        c.t = 5
+        self.assertEqual(b.tokens, 0)
+
+    def test_dump_load(self):
+        c = Clock()
+        L = Limiter(2, 1, c)
+        L.allow("a", 2)
+        M = Limiter.load(L.dump(), Clock(50))
+        self.assertFalse(M.allow("a"))
 
 
