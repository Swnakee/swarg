+import re
+from dataclasses import dataclass
+
+EMAIL = re.compile(r"^[^@\s]+@[^@\s]+\.[a-z]{2,}$", re.I)
+
+
+@dataclass
+class Account:
+    id: int
+    name: str
+    email: str
+    balance_cents: int = 0
+    tier: str = "basic"
+
+
+def new_account(next_id, name, email):
+    if not EMAIL.match(email):
+        raise ValueError("invalid account email: %s" % email)
+    return Account(next_id, name.strip(), email.lower())
