+
+def _half_up(x):
+    return math.floor(Fraction(x) + Fraction(1, 2))
+
+
+def quote(parcel, origin, dest, saturday=False):
+    _postcode(origin)
+    _postcode(dest)
+    if parcel["hazmat"]:
+        raise Prohibited("hazmat")
+    weight = Fraction(str(parcel["weight_kg"]))
+    if weight > 70:
+        raise ParcelTooHeavy("over 70 kg")
+    dims = [Fraction(str(parcel[k])) for k in ("l", "w", "h")]
+    billable = max(weight, dims[0] * dims[1] * dims[2] / 5000)
+    billable = max(Fraction(math.ceil(billable * 2), 2), Fraction(1))
+    zone = min(6, 1 + abs(int(origin[0]) - int(dest[0])))
+    rate = RATES[zone]
+    for limit, price in zip((1, 2, 5, 10, 20), rate[:5]):
+        if billable <= limit:
+            base = price
+            break
+    else:
+        base = rate[4] + math.ceil(billable - 20) * rate[5]
+    longest, *rest = sorted(dims, reverse=True)
+    oversize = 1500 if longest > 100 or longest + 2 * sum(rest) > 250 else 0
+    remote = 800 if dest[:2] in REMOTE_PREFIXES else 0
+    if saturday and remote:
+        raise ValueError("Saturday delivery is not available to remote areas")
+    sat = 500 if saturday else 0
+    fuel = _half_up(Fraction(base + oversize + remote + sat) * Fraction(825, 10000))
+    dv = parcel["declared_value"]
+    insurance = max(200, min(5000, _half_up(Fraction(dv, 100)))) if dv > 10000 else 0
+    out = {"base": base, "oversize": oversize, "remote": remote, "saturday": sat, "fuel": fuel,
+           "insurance": insurance}
+    out["total"] = sum(out.values())
+    return out
